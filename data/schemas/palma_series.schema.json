{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PalmaTimeSeriesSchema",
  "type": "object",
  "required": ["metadata", "series"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["title", "institution", "variable", "unit", "coverage"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "institution": { "type": "string" },
        "variable": { "type": "string" },
        "unit": { "type": "string" },
        "coverage": { "type": "string" },
        "license": { "type": "string" },
        "last_updated": { "type": "string" }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["year", "palma_ratio", "phase", "note_es", "note_en", "source"],
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 1990,
            "maximum": 2050
          },
          "palma_ratio": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 15.0
          },
          "phase": {
            "type": "string",
            "enum": ["crisis", "mejora", "regresion", "recuperacion"]
          },
          "note_es": { "type": "string" },
          "note_en": { "type": "string" },
          "source": { "type": "string" }
        }
      }
    }
  }
}